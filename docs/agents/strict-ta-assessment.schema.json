{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-trading-os.invalid/schemas/strict-ta-assessment.v1.json",
  "title": "Strict Trading Analysis Assessment",
  "description": "One specialist assessment for one exact code-owned master-list entry. Runtime enforcement is provided by src/lib/decision-gate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "masterListVersion",
    "catalogId",
    "category",
    "group",
    "name",
    "agentId",
    "status",
    "asOf"
  ],
  "properties": {
    "contractVersion": { "const": "strict-ta-assessment.v1" },
    "masterListVersion": { "const": "1.0.0" },
    "catalogId": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "group": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "agentId": {
      "enum": [
        "agent-01-smc-ict",
        "agent-02-price-action",
        "agent-03-support-resistance-trend",
        "agent-04-technical-indicators",
        "agent-05-order-flow-market-profile",
        "agent-06-divergence-intermarket",
        "agent-07-other-methods",
        "agent-08-fundamental-macro",
        "agent-09-risk-management-evaluation"
      ]
    },
    "status": { "enum": ["evaluated", "insufficient_data", "not_applicable", "unsupported"] },
    "asOf": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^snapshot:[a-fA-F0-9]{64}:[A-Za-z0-9._~-]+:[A-Za-z0-9._~/-]+$" }, "uniqueItems": true },
    "result": { "not": { "type": "null" } },
    "reason": { "type": "string", "minLength": 12 },
    "lookAheadSafe": { "const": true },
    "implementationVersion": { "type": "string", "minLength": 1 },
    "dataSnapshotId": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "evaluated" } }, "required": ["status"] },
      "then": { "required": ["evidenceRefs", "result", "lookAheadSafe", "implementationVersion", "dataSnapshotId"], "properties": { "evidenceRefs": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "unsupported" } }, "required": ["status"] },
      "then": { "required": ["reason"] }
    },
    {
      "if": { "properties": { "status": { "const": "insufficient_data" } }, "required": ["status"] },
      "then": { "required": ["reason"] }
    },
    {
      "if": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] },
      "then": { "required": ["reason", "evidenceRefs"], "properties": { "evidenceRefs": { "minItems": 1 } } }
    }
  ]
}
